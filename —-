<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Анонимизатор (Lightweight Russian NER)</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 800px; margin: 2em auto; padding: 0 1em; }
        textarea { width: 100%; height: 300px; margin-bottom: 1em; padding: 0.5em; box-sizing: border-box; }
        button { padding: 0.5em 2em; font-size: 1em; cursor: pointer; }
        #status { margin: 1em 0; color: #555; }
        .note { font-size: 0.9em; color: #777; margin-top: 2em; border-top: 1px solid #eee; padding-top: 1em; }
    </style>
</head>
<body>

    <h1>🔒 Анонимизация текстов (Легковесный NER)</h1>
    <textarea id="inputText" placeholder="Введите или вставьте текст..."></textarea>
    <button id="anonymizeBtn" disabled>Анонимизировать</button>
    <div id="status">Загрузка модели...</div>

    <div class="note">
        <strong>Как это работает:</strong> Легковесная нейросеть (120MB) запускается прямо в вашем браузере. 
        Текст анализируется локально и <strong>не передается</strong> на сервер.
    </div>

    <script type="module">
        import { pipeline } from 'https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.4.0';

        // --- ЭТАП 1: Загрузка легковесной модели ---
        const statusDiv = document.getElementById('status');
        const button = document.getElementById('anonymizeBtn');
        
        statusDiv.textContent = '⏳ Загружаем легковесную модель...';
        
        try {
            // Используем ультра-легковесную NER-модель
            const nerPipeline = await pipeline(
                'token-classification', 
                'sshleifer/tiny-distilbert-base-cased-distilled-squad',
                { progress_callback: (progress) => {
                    statusDiv.textContent = `⏳ Загрузка модели: ${Math.round(progress.progress)}%`;
                }}
            );
            
            statusDiv.textContent = '✅ Модель готова. Можно вводить текст.';
            button.disabled = false;
        } catch (error) {
            console.error('Ошибка загрузки модели:', error);
            statusDiv.textContent = '❌ Ошибка загрузки модели. Попробуйте обновить страницу.';
            return;
        }

        // --- ЭТАП 2: Логика анонимизации ---
        button.addEventListener('click', async () => {
            const inputText = document.getElementById('inputText').value;
            if (!inputText.trim()) {
                statusDiv.textContent = '⚠️ Введите текст для анонимизации.';
                return;
            }

            // Визуальная обратная связь
            button.disabled = true;
            statusDiv.textContent = '⏳ Идет анализ текста...';

            try {
                // Обработка текста
                const entities = await nerPipeline(inputText);
                
                // Простая анонимизация на основе найденных сущностей
                const maskedText = maskEntities(inputText, entities);
                
                // Вывод результата в то же поле
                document.getElementById('inputText').value = maskedText;
                statusDiv.textContent = `✅ Готово! Найдено и заменено ${entities.length} сущностей.`;
            } catch (error) {
                console.error('Ошибка анонимизации:', error);
                statusDiv.textContent = '❌ Произошла ошибка. Попробуйте еще раз.';
                button.disabled = false;
            }
        });

        /**
         * Вспомогательная функция для замены найденных сущностей на маски.
         */
        function maskEntities(text, entities) {
            if (!entities || entities.length === 0) return text;

            // 1. Группируем подслова одной сущности в блоки
            const entityBlocks = [];
            let currentBlock = null;

            for (let i = 0; i < entities.length; i++) {
                const ent = entities[i];
                // Определяем тип сущности, убирая префикс BIO
                const bioTag = ent.entity ? ent.entity.split('-')[0] : 'O'; // B, I, O
                const entityType = ent.entity ? ent.entity.split('-').slice(1).join('-') : '';
                
                if (bioTag === 'B' || bioTag === 'U') {
                    // Начало новой сущности
                    if (currentBlock) {
                        entityBlocks.push(currentBlock);
                    }
                    currentBlock = {
                        start: ent.start,
                        end: ent.end,
                        type: entityType,
                        score: ent.score
                    };
                } else if (bioTag === 'I' && currentBlock) {
                    // Продолжение текущей сущности
                    currentBlock.end = ent.end;
                    currentBlock.score = Math.min(currentBlock.score, ent.score);
                } else if (bioTag === 'L' && currentBlock) {
                    // Конец сущности
                    currentBlock.end = ent.end;
                    currentBlock.score = Math.min(currentBlock.score, ent.score);
                    entityBlocks.push(currentBlock);
                    currentBlock = null;
                } else if (bioTag === 'O') {
                    // Вне сущности - если был блок, завершаем его
                    if (currentBlock) {
                        entityBlocks.push(currentBlock);
                        currentBlock = null;
                    }
                }
            }
            
            // Добавляем последний блок, если он есть
            if (currentBlock) {
                entityBlocks.push(currentBlock);
            }

            // 2. Сортируем блоки по позиции в тексте (с конца, чтобы не сбить индексы)
            entityBlocks.sort((a, b) => b.start - a.start);

            // 3. Заменяем каждый блок на маску
            let result = text;
            for (const block of entityBlocks) {
                // Проверяем, что индексы валидны
                if (block.start >= 0 && block.end <= result.length && block.start <= block.end) {
                    const before = result.substring(0, block.start);
                    const after = result.substring(block.end);
                    result = before + `[${mapEntityType(block.type)}]` + after;
                }
            }

            return result;
        }

        /**
         * Сопоставление типов сущностей с метками.
         */
        function mapEntityType(type) {
            const typeMap = {
                'PER': 'ФИО',
                'PERSON': 'ФИЗ_ЛИЦО',
                'ORG': 'ОРГАНИЗАЦИЯ',
                'ORGANIZATION': 'ОРГАНИЗАЦИЯ',
                'LOC': 'МЕСТО',
                'GPE': 'ЛОКАЦИЯ',
                'MISC': 'ДРУГОЕ',
            };
            return typeMap[type] || 'СУЩНОСТЬ';
        }

    </script>
</body>
</html>
